{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-footer": "This PR was generated with [Release Please](https://github.com/googleapis/release-please).",
  "pull-request-title-pattern": "chore${scope}: release ${version}",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "docs", "section": "Documentation" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "test", "section": "Tests" },
    { "type": "chore", "section": "Maintenance", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "component": "woodpecker-ci-plugin",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".codex-plugin/plugin.json", "jsonpath": "$.version" }
      ]
    }
  }
}
